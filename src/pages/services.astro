---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { servicesMeta } from '../data/site';
import { engagements, processSteps } from '../data/services';
import { contact, servicesForm } from '../data/config';
import { buildCanonicalUrl } from '../lib/seo';
import { resolveServicesContact } from '../lib/contact-config';

/**
 * Hero and contact copy short enough, and used only on this page, that it
 * does not warrant its own src/data module (see handoff README "3.
 * Services" and the Services prototype, lines 47-55 and 159-166).
 */
const servicesHero = {
  eyebrow: 'Servicios',
  heading: 'Ayuda de ingeniería enfocada para software que necesita funcionar.',
  lead: 'Cuatro tipos de encargo con alcance explícito, tests prácticos y un traspaso conciso. Cada uno termina con algo que puedes ejecutar y verificar sin que yo esté en la sala.',
};

const contactCopy = {
  heading: 'Envía el contexto, no un brief.',
  body: 'Cuéntame qué está pasando, qué debería pasar en su lugar y qué has probado ya. Te responderé con el siguiente paso más útil.',
  notice: 'Comparte solo lo que sea seguro discutir. No incluyas credenciales ni datos sensibles de clientes.',
};

/** Matches the prototype's 0/80/160/240ms stagger on the four process steps. */
const revealDelays = [0, 80, 160, 240];

const canonicalUrl = buildCanonicalUrl(Astro.site, Astro.url.pathname);
const servicesContact = resolveServicesContact(servicesForm.formspreeEndpoint, contact.email);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: buildCanonicalUrl(Astro.site, '/') },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonicalUrl },
  ],
};

const offerCatalogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Servicios de desarrollo freelance — Alex Cuesta',
  itemListElement: engagements.map((engagement) => ({
    '@type': 'Service',
    name: engagement.title,
    description: engagement.description,
    areaServed: {
      '@type': 'Place',
      name: 'Sevilla, España',
    },
    provider: {
      '@type': 'Person',
      name: 'Alex Cuesta',
    },
  })),
};
---

<BaseLayout
  title={servicesMeta.title}
  description={servicesMeta.description}
  activeNav="services"
  showServicesNav={true}
  isHome={false}
  isServices={true}
  footerBackground="canvas"
  footerShowNav={true}
  ogType="website"
  jsonLd={[breadcrumbJsonLd, offerCatalogJsonLd]}
>
  <section class="services-hero" id="services">
    <div class="services-hero__inner container">
      <div class="services-hero__grid" data-reveal>
        <div>
          <p class="services-hero__eyebrow font-mono">{servicesHero.eyebrow}</p>
          <h1 class="services-hero__title">{servicesHero.heading}</h1>
        </div>
        <p class="services-hero__lead">{servicesHero.lead}</p>
      </div>
    </div>
  </section>

  <section class="engagements" aria-label="Encargos">
    <div class="container engagements__inner">
      {
        engagements.map((engagement) => (
          <article class="engagement" data-reveal>
            <p class="engagement__index font-mono">{engagement.index}</p>
            <div>
              <h2 class="engagement__title">{engagement.title}</h2>
              <p class="engagement__description">{engagement.description}</p>
              <p class="engagement__pricing font-mono">{engagement.pricingNote}</p>
            </div>
            <div class="engagement__details">
              <div>
                <h3 class="mono-label">Recibes</h3>
                <ul class="engagement__receive-list">
                  {engagement.youReceive.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="mono-label">Fuera de alcance</h3>
                <p class="engagement__out-of-scope">{engagement.outOfScope}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="process" aria-labelledby="process-heading">
    <div class="container process__inner">
      <h2 id="process-heading" class="process__heading" data-reveal>
        Cómo se desarrolla un encargo.
      </h2>
      <ol class="process__list">
        {
          processSteps.map((step, index) => (
            <li class="process__step" data-reveal data-reveal-delay={revealDelays[index]}>
              <p class="mono-label process__step-index">{step.index}</p>
              <h3 class="process__step-title">{step.title}</h3>
              <p class="process__step-description">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="container contact__inner">
      <div data-reveal>
        <h2 id="contact-heading" class="contact__heading">{contactCopy.heading}</h2>
        <p class="contact__body">{contactCopy.body}</p>
        <p class="contact__notice">{contactCopy.notice}</p>
      </div>
      {
        servicesContact.formEnabled && servicesContact.endpoint ? (
          <ContactForm endpoint={servicesContact.endpoint} />
        ) : (
          <div class="contact-fallback" data-reveal data-reveal-delay="100">
            <p class="contact-fallback__label font-mono">CONTACTO DIRECTO</p>
            <p class="contact-fallback__body">
              El formulario estará disponible cuando termine la configuración del envío. Mientras tanto,
              puedes contarme el contexto directamente por email.
            </p>
            <a class="contact-fallback__link" href={servicesContact.fallbackHref}>Escribirme por email</a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>

<style>
  .services-hero__inner {
    padding-block: 96px 80px;
  }

  .services-hero__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(40px, 5vw, 80px);
    align-items: end;
  }

  .services-hero__eyebrow {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 28px;
  }

  .services-hero__title {
    font-size: clamp(40px, 4.6vw, 56px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: pretty;
  }

  .services-hero__lead {
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.45;
    color: var(--muted);
    margin: 0;
    max-width: 50ch;
  }

  .engagements {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .engagements__inner {
    padding-block: clamp(72px, 8vw, 112px);
  }

  .engagement {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(24px, 3vw, 48px);
    align-items: start;
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
  }

  .engagement:first-child {
    padding-top: 0;
  }

  .engagement:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .engagement__index {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0;
  }

  .engagement__title {
    font-size: clamp(23px, 2vw, 26px);
    line-height: 1.2;
    font-weight: 600;
    margin: 0;
  }

  .engagement__description {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 46ch;
  }

  .engagement__pricing {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    margin: 20px 0 0;
  }

  .engagement__details {
    display: grid;
    gap: 28px;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 12px;
  }

  .engagement__receive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .engagement__receive-list li {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
  }

  .engagement__out-of-scope {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 50ch;
  }

  .process {
    border-top: 1px solid var(--line);
    background: var(--canvas);
  }

  .process__inner {
    padding-block: clamp(72px, 8vw, 112px);
  }

  .process__heading {
    font-size: clamp(32px, 3.4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 24ch;
  }

  .process__list {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 40px;
  }

  .process__step {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .process__step-index {
    margin: 0 0 12px;
  }

  .process__step-title {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    margin: 0;
  }

  .process__step-description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 8px 0 0;
  }

  .contact {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .contact__inner {
    padding-block: clamp(72px, 8vw, 112px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }

  .contact__heading {
    font-size: clamp(32px, 3.4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: pretty;
  }

  .contact__body {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin: 24px 0 0;
    max-width: 50ch;
  }

  .contact__notice {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    margin: 28px 0 0;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    max-width: 46ch;
  }

  .contact-fallback {
    display: grid;
    gap: 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 40px;
    background: var(--canvas);
  }

  .contact-fallback__label {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .contact-fallback__body {
    margin: 0;
    max-width: 44ch;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .contact-fallback__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .contact-fallback__link:hover {
    background: var(--accent-hover);
    color: var(--accent-ink);
    text-decoration: none;
  }
</style>
