---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabProjectCard from '../components/LabProjectCard.astro';
import { contact } from '../data/config';
import { laboratoryMeta } from '../data/site';
import { LAB_PROJECT_COUNT, labPillars, labProjects } from '../data/lab';
import { buildCanonicalUrl } from '../lib/seo';

const flagshipCount = labProjects.filter((project) => project.flagship).length;
const canonicalUrl = buildCanonicalUrl(Astro.site, Astro.url.pathname);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: buildCanonicalUrl(Astro.site, '/') },
    { '@type': 'ListItem', position: 2, name: 'Laboratorio', item: canonicalUrl },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: laboratoryMeta.title,
  description: laboratoryMeta.description,
  url: canonicalUrl,
  inLanguage: 'es-ES',
  hasPart: labProjects
    .filter((project) => project.flagship)
    .map((project) => ({
      '@type': 'SoftwareApplication',
      name: project.title,
      description: project.problem,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Web',
      url: project.demoUrl,
      codeRepository: project.repoUrl,
    })),
};
---

<BaseLayout
  title={laboratoryMeta.title}
  description={laboratoryMeta.description}
  activeNav="laboratorio"
  footerBackground="surface"
  footerShowNav={true}
  ogType="website"
  jsonLd={[breadcrumbJsonLd, collectionJsonLd]}
>
  <section class="lab-hero">
    <div class="container lab-hero__inner">
      <div data-reveal>
        <p class="lab-hero__eyebrow font-mono">LABORATORIO · CÓDIGO PÚBLICO</p>
        <h1 class="lab-hero__title">Sistemas pequeños para estudiar fallos reales.</h1>
      </div>
      <div class="lab-hero__aside" data-reveal data-reveal-delay="100">
        <p class="lab-hero__lead">
          No es una cuadrícula de demos aisladas. Es evidencia ejecutable de cómo trabajo con contratos,
          recuperación, operaciones e IA: un problema acotado, una interfaz verificable y un límite honesto.
        </p>
        <div class="lab-hero__actions">
          <a class="lab-button lab-button--primary" href="#pilares">Ver proyectos destacados</a>
          <a class="lab-button lab-button--secondary" href="https://github.com/Aredex" target="_blank" rel="noreferrer">
            Ver GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="lab-metrics" aria-label="Estado del laboratorio">
    <div class="container lab-metrics__grid">
      <p><strong>{LAB_PROJECT_COUNT}</strong><span>proyectos desplegados</span></p>
      <p><strong>{flagshipCount}</strong><span>proyectos destacados</span></p>
      <p><strong>{labPillars.length}</strong><span>pilares de trabajo</span></p>
      <p><strong>100%</strong><span>demo y código públicos</span></p>
    </div>
    <p class="visually-hidden">29 proyectos desplegados</p>
  </section>

  <div id="pilares" class="lab-pillars">
    {
      labPillars.map((pillar) => {
        const projects = labProjects.filter((project) => project.pillar === pillar.id);
        const flagships = projects.filter((project) => project.flagship);
        const additional = projects.filter((project) => !project.flagship);

        return (
          <section id={pillar.id} class="lab-pillar" data-lab-pillar aria-labelledby={`${pillar.id}-heading`}>
            <div class="container">
              <header class="lab-pillar__header" data-reveal>
                <p class="lab-pillar__index font-mono">{pillar.index}</p>
                <div>
                  <h2 id={`${pillar.id}-heading`} class="lab-pillar__title">{pillar.title}</h2>
                  <p class="lab-pillar__thesis">{pillar.thesis}</p>
                </div>
              </header>

              <ol class="failure-trace" aria-label={`Secuencia de trabajo: ${pillar.trace.join(', ')}`} data-reveal>
                {pillar.trace.map((step, index) => (
                  <li>
                    <span class="font-mono">0{index + 1}</span>
                    {step}
                  </li>
                ))}
              </ol>

              <div class="lab-pillar__featured">
                {flagships.map((item) => <LabProjectCard project={item} />)}
              </div>

              {additional.length > 0 && (
                <details class="lab-more">
                  <summary>
                    <span>Explorar {additional.length} proyectos adicionales</span>
                    <span class="lab-more__hint font-mono">ABRIR CATÁLOGO</span>
                  </summary>
                  <div class="lab-more__grid">
                    {additional.map((item) => <LabProjectCard project={item} compact={true} />)}
                  </div>
                </details>
              )}
            </div>
          </section>
        );
      })
    }
  </div>

  <section id="contact" class="lab-contact" aria-labelledby="lab-contact-heading">
    <div class="container lab-contact__inner" data-reveal>
      <div>
        <p class="lab-contact__eyebrow font-mono">DEL LABORATORIO AL PRODUCTO</p>
        <h2 id="lab-contact-heading">¿Hay un fallo parecido escondido en tu sistema?</h2>
      </div>
      <div>
        <p>
          Puedo convertir este mismo enfoque —contrato, reproducción y evidencia— en una revisión acotada de tu
          API, automatización o herramienta interna.
        </p>
        <a class="lab-button lab-button--primary" href={contact.email}>Contarme el contexto</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>

<style>
  .lab-hero {
    padding-block: clamp(64px, 9vw, 128px);
  }

  .lab-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: clamp(48px, 7vw, 112px);
    align-items: end;
  }

  .lab-hero__eyebrow,
  .lab-pillar__index,
  .lab-contact__eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .lab-hero__title {
    max-width: 15ch;
    margin: 28px 0 0;
    font-size: clamp(44px, 5.8vw, 76px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .lab-hero__aside {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .lab-hero__lead {
    max-width: 50ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
  }

  .lab-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .lab-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .lab-button--primary {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .lab-button--primary:hover {
    background: var(--accent-hover);
    color: var(--accent-ink);
    text-decoration: none;
  }

  .lab-button--secondary {
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .lab-button--secondary:hover {
    border-color: var(--ink);
    color: var(--ink);
    text-decoration: none;
  }

  .lab-metrics {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .lab-metrics__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .lab-metrics p {
    margin: 0;
    padding: 30px clamp(12px, 2.5vw, 32px);
    border-left: 1px solid var(--line);
  }

  .lab-metrics p:first-child {
    border-left: 0;
  }

  .lab-metrics strong,
  .lab-metrics span {
    display: block;
  }

  .lab-metrics strong {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .lab-metrics span {
    margin-top: 9px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
  }

  .lab-pillar {
    padding-block: clamp(80px, 10vw, 136px);
    border-bottom: 1px solid var(--line);
  }

  .lab-pillar:nth-child(even) {
    background: var(--surface);
  }

  .lab-pillar__header {
    display: grid;
    grid-template-columns: minmax(140px, 0.32fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .lab-pillar__title {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .lab-pillar__thesis {
    max-width: 64ch;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
  }

  .failure-trace {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .failure-trace li {
    position: relative;
    min-height: 64px;
    padding: 16px 24px 16px 0;
    border-top: 2px solid var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .failure-trace li::before {
    position: absolute;
    width: 9px;
    height: 9px;
    top: -5px;
    left: 0;
    border-radius: 50%;
    background: var(--ink);
    content: '';
  }

  .failure-trace span {
    margin-right: 10px;
    color: var(--muted);
    font-size: 10px;
  }

  .lab-pillar__featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .lab-more {
    margin-top: 32px;
    border-bottom: 1px solid var(--line);
  }

  .lab-more summary {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    cursor: pointer;
    font-weight: 600;
  }

  .lab-more__hint {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .lab-more__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    padding-bottom: 32px;
  }

  .lab-contact {
    padding-block: clamp(72px, 9vw, 120px);
    background: var(--ink);
    color: var(--canvas);
  }

  .lab-contact__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 7vw, 96px);
  }

  .lab-contact__eyebrow {
    color: color-mix(in srgb, var(--canvas) 65%, transparent);
  }

  .lab-contact h2 {
    max-width: 17ch;
    margin: 20px 0 0;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .lab-contact p:not(.lab-contact__eyebrow) {
    max-width: 48ch;
    margin: 0 0 28px;
    color: color-mix(in srgb, var(--canvas) 75%, transparent);
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .lab-hero__inner,
    .lab-contact__inner {
      grid-template-columns: 1fr;
    }

    .lab-metrics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lab-metrics p:nth-child(3) {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .lab-metrics p:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .lab-pillar__featured {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .lab-pillar__header,
    .lab-more__grid {
      grid-template-columns: 1fr;
    }

    .failure-trace {
      grid-template-columns: 1fr;
    }

    .failure-trace li {
      min-height: 52px;
    }

    .lab-more summary {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
