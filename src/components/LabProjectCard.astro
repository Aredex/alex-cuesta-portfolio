---
import type { LabProject } from '../data/lab';

export interface Props {
  project: LabProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
---

<article
  class:list={['lab-card', { 'lab-card--compact': compact }]}
  id={project.slug}
  data-lab-project
  data-flagship={project.flagship ? 'true' : 'false'}
  data-status={project.status}
>
  <div class="lab-card__topline">
    <p class="lab-card__slug font-mono">{project.slug}</p>
    {project.status === 'degraded' ? (
      <span class="lab-card__badge lab-card__badge--degraded font-mono" aria-label="Estado: degradado">
        DEGRADADO
      </span>
    ) : (
      project.flagship && <span class="lab-card__badge font-mono">DESTACADO</span>
    )}
  </div>
  <h3 class="lab-card__title">{project.title}</h3>
  <p class="lab-card__problem">{project.problem}</p>
  <p class="lab-card__stack font-mono">{project.stack.join(' · ')}</p>
  {project.statusNote && (
    <div class="lab-card__limitation" data-lab-status>
      <span class="font-mono">ESTADO</span>
      <p>{project.statusNote}</p>
    </div>
  )}
  <div class="lab-card__limitation" data-lab-limitation>
    <span class="font-mono">LÍMITE</span>
    <p>{project.limitation}</p>
  </div>
  <div class="lab-card__actions">
    {project.status === 'active' && <a href={project.demoUrl} target="_blank" rel="noreferrer">Abrir demo</a>}
    <a href={project.repoUrl} target="_blank" rel="noreferrer">Ver código</a>
  </div>
</article>

<style>
  .lab-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.5vw, 32px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }

  .lab-card--compact {
    padding: 24px;
    border-radius: 0;
    border-width: 1px 0 0;
    background: transparent;
  }

  .lab-card__topline {
    min-height: 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .lab-card__slug {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .lab-card__badge {
    flex: 0 0 auto;
    padding: 3px 8px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .lab-card__badge--degraded {
    border-color: var(--line);
    color: var(--muted);
  }

  .lab-card__title {
    margin: 20px 0 0;
    font-size: clamp(21px, 2vw, 25px);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .lab-card--compact .lab-card__title {
    font-size: 20px;
  }

  .lab-card__problem {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .lab-card__stack {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .lab-card__limitation {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .lab-card__limitation span {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .lab-card__limitation p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .lab-card__actions {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .lab-card__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
  }
</style>
